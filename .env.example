# AutoFlow Environment Configuration
# Copy this file to .env and fill in your values

# ─── Application ────────────────────────────────────────
APP_ENV=development
APP_NAME=AutoFlow
APP_VERSION=0.1.0
APP_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
API_V1_PREFIX=/api/v1

# ─── Database (PostgreSQL) ───────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=autoflow
POSTGRES_USER=autoflow
POSTGRES_PASSWORD=autoflow_dev_password
DATABASE_URL=postgresql+asyncpg://autoflow:autoflow_dev_password@localhost:5432/autoflow

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery uses a separate Redis DB to avoid collision
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ─── AI Provider ────────────────────────────────────────
# Provider: "ollama" | "openai" | "anthropic" | "gemini" | "groq" | "custom"
AI_PROVIDER=ollama

# Ollama (local, default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# OpenAI (swap by setting AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (swap by setting AI_PROVIDER=anthropic)
# Note: AutoFlow uses an OpenAI-compatible proxy for Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-20241022

# Google Gemini (swap by setting AI_PROVIDER=gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Groq (swap by setting AI_PROVIDER=groq)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Custom OpenAI-compatible provider
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# Shared AI settings
AI_TEMPERATURE=0.1
AI_MAX_TOKENS=4096
AI_TIMEOUT_SECONDS=60

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","chrome-extension://"]

# ─── Security ───────────────────────────────────────────
# Master encryption key for stored credentials (Fernet, 32-byte base64 URL-safe)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# API Key for Chrome Extension authentication (generate a random UUID)
EXTENSION_API_KEY=change-me-generate-uuid

# ─── Feature Flags ──────────────────────────────────────
ENABLE_PLAYWRIGHT_EXECUTION=true
ENABLE_AI_INTENT_EXTRACTION=true
ENABLE_REAL_TIME_STREAMING=true
